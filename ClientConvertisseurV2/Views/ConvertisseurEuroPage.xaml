<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClientConvertisseurV1.Views.ConvertisseurEuroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClientConvertisseurV1.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <RelativePanel>

        <TextBlock
            x:Name="TitleMontant"
            Margin="0,50,0,10"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            Text="Montant en Euros" />

        <TextBox
            x:Name="TxtMontantEuro"
            Width="200"
            Margin="0,0,0,20"
            PlaceholderText="Entrez un montant"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.Below="TitleMontant" />

        <TextBlock
            x:Name="TitleDevise"
            Margin="0,0,0,10"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.Below="TxtMontantEuro"
            Text="Devise" />

        <ComboBox
            x:Name="CbDevise"
            Width="200"
            Margin="0,0,0,20"
            PlaceholderText="Sélectionnez une devise"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.Below="TitleDevise" />

        <Button
            x:Name="BtnConvertir"
            Width="200"
            Margin="0,0,0,20"
            Click="BtnConvertir_Click"
            Content="Convertir"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.Below="CbDevise" />

        <TextBlock
            x:Name="TitleResultat"
            Margin="0,0,0,10"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.Below="BtnConvertir"
            Text="Montant en devises" />

        <TextBox
            x:Name="TxtResultat"
            Width="200"
            IsReadOnly="True"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.Below="TitleResultat"
            Text="0" />

    </RelativePanel>
</Page>
